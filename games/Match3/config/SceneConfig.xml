<?xml version="1.0"?>
<SceneManager contentVersion="5">
  <scenes>
    <!-- The first screen: a title and two buttons on a Screen canvas. Match3MenuComponent answers Match3Play and Match3Quit. -->
    <scene
      type="Scene"
      name="MainMenu">
      <nodes>
        <node name="Menu" layer="10">
          <components>
            <component type="Match3MenuComponent" gameScene="Match3Scene" />
            <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.7" useSafeArea="true">
              <elements>
                <element type="UIStack" name="Column" anchor="Center" width="90%" maxWidth="320" height="232" direction="Vertical" spacing="16" crossAlign="Stretch">
                  <children>
                    <element type="UIElement" name="Title" height="88" fontSize="56">
                      <components>
                        <component type="UITextComponent" text="Match 3" align="Center" verticalAlign="Center"/>
                      </components>
                    </element>
                    <element type="UIElement" name="Play" height="56" fontSize="28" color="40,90,60,255">
                      <components>
                        <component type="UITextComponent" text="Play" align="Center" verticalAlign="Center" wrap="false"/>
                        <component type="UIInputClicker" action="Match3Play"/>
                      </components>
                    </element>
                    <element type="UIElement" name="Quit" height="56" fontSize="28" color="90,50,50,255">
                      <components>
                        <component type="UITextComponent" text="Quit" align="Center" verticalAlign="Center" wrap="false"/>
                        <component type="UIInputClicker" action="Match3Quit"/>
                      </components>
                    </element>
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
      </nodes>
    </scene>

    <!-- The board is 512 x 512 at (100, 80); the view keeps the same margin on every side, and the engine fits it to the window. -->
    <scene
      type="Scene"
      name="Match3Scene"
      viewWidth="712"
      viewHeight="672">
      <nodes>
        <node name="Board">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="Match3BoardComponent" originX="100" originY="80" cellSize="64" seed="1337" menuScene="MainMenu" />
          </components>
        </node>
        <!-- The burst of every cleared gem (Match3BoardComponent::burstNode): the board throws it in the gem's color at the cell, so the node has no place of its own.
             Above the board, below the HUD. -->
        <node name="ClearBurst" layer="5">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="ParticleEmitterComponent" playOnStart="false">
              <effect burstCount="8" maxParticles="256" lifetimeMin="0.3" lifetimeMax="0.55" shape="Circle" shapeRadius="6" speedMin="60" speedMax="160" direction="0" spread="360" gravityY="150" blend="Add" frameClass="FiniteEffect">
                <size from="10" to="2" ease="QuadOut"/>
                <color>
                  <from r="255" g="255" b="255" a="255"/>
                  <to r="255" g="255" b="255" a="0"/>
                </color>
              </effect>
            </component>
          </components>
        </node>
        <!-- The HUD is in the margins of the view (space="SceneView"), so it scales and moves with the board and never covers it, whatever the shape of the window.
             The buttons are 48 units high: at the smallest fit scale of the size matrix (0.67) that is still a 32 px touch target. -->
        <node name="Hud" layer="10">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
              <elements>
                <element type="UIElement" name="Score" x="96" y="12" width="250" height="40" fontSize="28">
                  <components>
                    <component type="UITextComponent" text="Score: {score}" verticalAlign="Center"/>
                  </components>
                </element>
                <element type="UIStack" name="Buttons" anchor="TopRight" x="-96" y="12" width="260" height="48" direction="Horizontal" spacing="12" crossAlign="Stretch">
                  <children>
                    <element type="UIElement" name="Reset" width="124" height="48" fontSize="24" color="40,90,60,255">
                      <components>
                        <component type="UITextComponent" text="Reset" align="Center" verticalAlign="Center" wrap="false"/>
                        <component type="UIInputClicker" action="Match3Reset"/>
                      </components>
                    </element>
                    <element type="UIElement" name="Menu" width="124" height="48" fontSize="24" color="70,70,100,255">
                      <components>
                        <component type="UITextComponent" text="Menu" align="Center" verticalAlign="Center" wrap="false"/>
                        <component type="UIInputClicker" action="Match3Menu"/>
                      </components>
                    </element>
                  </children>
                </element>
                <element type="UIElement" name="Seed" anchor="BottomLeft" x="96" y="-26" width="300" height="24" fontSize="16">
                  <components>
                    <component type="UITextComponent" text="seed {seed}" textColor="190,190,190,255"/>
                  </components>
                </element>
              </elements>
            </component>
          </components>
        </node>
      </nodes>
    </scene>
  </scenes>
</SceneManager>
