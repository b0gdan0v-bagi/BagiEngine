{
    "name": "todo-workers",
    "displayName": "Todo Workers",
    "description": "The parallel todo-loop workers of BagiEngine: their sessions, entries and branches, and the entries waiting for /todo-merge.",
    "version": "0.16.0",
    "publisher": "bagiengine",
    "license": "UNLICENSED",
    "private": true,
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "workspaceContains:tools/todo/worker.py",
        "workspaceContains:engine/tools/todo/worker.py"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "todoWorkers",
                    "title": "Todo Workers",
                    "icon": "media/workers.svg"
                }
            ]
        },
        "views": {
            "todoWorkers": [
                {
                    "type": "webview",
                    "id": "todoWorkers.view",
                    "name": "Workers"
                }
            ]
        },
        "commands": [
            {
                "command": "todoWorkers.refresh",
                "title": "Refresh",
                "icon": "$(refresh)",
                "category": "Todo Workers"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "todoWorkers.refresh",
                    "when": "view == todoWorkers.view",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "Todo Workers",
            "properties": {
                "todoWorkers.python": {
                    "type": "string",
                    "default": "python3",
                    "description": "The Python that runs tools/todo/worker.py."
                },
                "todoWorkers.claude": {
                    "type": "string",
                    "default": "claude",
                    "description": "The Claude Code command (a full path when VS Code does not see it on PATH)."
                },
                "todoWorkers.refreshSeconds": {
                    "type": "number",
                    "default": 15,
                    "minimum": 5,
                    "description": "How often the panel asks worker.py (it also asks the todo store and reads the session transcripts)."
                },
                "todoWorkers.startSlices": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "description": "Fast start: N of `/todo-loop N`, the slices the loop takes."
                },
                "todoWorkers.loopArgs": {
                    "type": "string",
                    "default": "",
                    "description": "Fast start: more arguments of /todo-loop (worker.py start --loop-args), e.g. 'models=reviewer:sonnet' or an entry id."
                },
                "todoWorkers.reportTo": {
                    "type": "string",
                    "default": "",
                    "description": "Fast start: the Claude session the loop sends its reports to (worker.py start --report-to); empty for none."
                },
                "todoWorkers.notify": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a notification when an entry reaches review or a worker's session ends."
                },
                "todoWorkers.autoStartQueue": {
                    "type": "boolean",
                    "default": true,
                    "description": "Start the next queued entry of a worker (worker.py queue) as soon as the worker is free: no session running, no uncommitted changes, its entry in review or none."
                },
                "todoWorkers.preset": {
                    "type": "string",
                    "default": "",
                    "description": "The configure/build preset of Verify, Merge + test, Build & run and Shots; empty: the debug preset of this platform (worker.py build-info)."
                },
                "todoWorkers.prices": {
                    "type": "object",
                    "default": {
                        "fable": {
                            "input": 8,
                            "output": 40,
                            "cacheWrite": 10,
                            "cacheRead": 0.2
                        },
                        "mythos": {
                            "input": 8,
                            "output": 40,
                            "cacheWrite": 10,
                            "cacheRead": 0.2
                        },
                        "opus": {
                            "input": 4,
                            "output": 20,
                            "cacheWrite": 5,
                            "cacheRead": 0.2
                        },
                        "sonnet": {
                            "input": 2,
                            "output": 10,
                            "cacheWrite": 2.5,
                            "cacheRead": 0.1
                        },
                        "haiku": {
                            "input": 0.1,
                            "output": 0.5,
                            "cacheWrite": 0.125,
                            "cacheRead": 0.01
                        }
                    },
                    "description": "Dollars per million tokens by model family (the first key that is part of a model id): what the panel's costs are counted with. API list prices; a subscription bills otherwise."
                }
            }
        }
    }
}
