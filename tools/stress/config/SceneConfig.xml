<?xml version="1.0"?>
<SceneManager contentVersion="5">
  <scenes>
    <!-- The scenes of BagiStress (the fourth, StressRmlUi, is shown only in a build with the RmlUi host); StressGame::GetSceneName() is the one chosen by --stress-scene. The Field node gets the scene's component, the Run node the measurement (after Field: a frame builds before it is judged). -->
    <scene type="Scene" name="StressSprites" viewWidth="1920" viewHeight="1080">
      <nodes>
        <node name="Field">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="StressSpritesComponent" />
          </components>
        </node>
        <node name="Run">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="StressRunComponent" />
          </components>
        </node>
      </nodes>
    </scene>
    <scene type="Scene" name="StressEntities" viewWidth="1920" viewHeight="1080">
      <nodes>
        <node name="Field">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="StressEntitiesComponent" />
          </components>
        </node>
        <node name="Run">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="StressRunComponent" />
          </components>
        </node>
      </nodes>
    </scene>
    <scene type="Scene" name="StressUi" viewWidth="1920" viewHeight="1080">
      <nodes>
        <node name="Field">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1920" referenceHeight="1080" match="0.5">
              <elements />
            </component>
            <component type="StressUiComponent" />
          </components>
        </node>
        <node name="Run">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="StressRunComponent" />
          </components>
        </node>
      </nodes>
    </scene>
    <!-- Many RmlUi contexts, each with text at several font sizes (texture churn), and a scrollable panel; only a build with ENGINE_UI_RMLUI lists it and fills it (the component does nothing without) -->
    <scene type="Scene" name="StressRmlUi" viewWidth="1920" viewHeight="1080">
      <nodes>
        <node name="Field">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="StressRmlUiComponent" />
          </components>
        </node>
        <node name="Run">
          <components>
            <component type="TransformComponent" x="0" y="0" width="0" height="0" />
            <component type="StressRunComponent" />
          </components>
        </node>
      </nodes>
    </scene>
  </scenes>
</SceneManager>
