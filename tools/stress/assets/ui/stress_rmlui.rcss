/* The scrollable panel of the stress scene `rmlui`: the box scrolls on both axes and its content is larger than the box in both,
   so a wheel of either axis moves it. The coloured corners show in a screenshot which part of the content is visible. */
body {
    width: 100%;
    height: 100%;
    font-family: "PT Sans";
    color: white;
}

div {
    display: block;
}

#scroller {
    position: absolute;
    right: 40dp;
    bottom: 40dp;
    width: 360dp;
    height: 240dp;
    overflow: scroll;
    background-color: rgba(20, 20, 30, 230);
}

#content {
    position: relative;
    width: 1000dp;
    height: 700dp;
}

.corner {
    position: absolute;
    width: 120dp;
    height: 90dp;
    font-size: 28dp;
    line-height: 90dp;
    text-align: center;
}

.top-left {
    left: 0;
    top: 0;
    background-color: rgb(200, 60, 60);
}

.top-right {
    right: 0;
    top: 0;
    background-color: rgb(60, 180, 60);
}

.bottom-left {
    left: 0;
    bottom: 0;
    background-color: rgb(60, 90, 200);
}

.bottom-right {
    right: 0;
    bottom: 0;
    background-color: rgb(200, 180, 60);
}
