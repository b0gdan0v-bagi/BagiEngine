<?xml version="1.0"?>
<!-- A UISegmented whose segments carry an icon: icon only (with a tooltip), icon left of a caption with the colour of the chosen one, and a disabled segment. A segment without a name has children without one. -->
<node name="IconSegments" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UISegmented" name="Mode" bind="mode" x="10" y="10" width="360" height="56" direction="Horizontal" spacing="4" color="30,34,46,255">
          <children>
            <element type="UIElement" name="ModeGrid" flex="1" height="100%" color="70,70,100,255" selectedColor="40,110,60,255">
              <components>
                <component type="UITextComponent" textColor="240,240,240,255"/>
                <component type="UIInputClicker" action="SetMode" value="grid"/>
                <component type="UITooltipComponent" text="{#tip.grid}"/>
              </components>
              <children>
                <element type="UIElement" name="ModeGridIcon" anchor="Center" width="60%" height="60%" aspectRatio="1">
                  <components>
                    <component type="UIImageComponent" sprite="icons.grid" tint="240,240,240,255"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIElement" name="ModeList" flex="1" height="100%" color="70,70,100,255" selectedColor="40,110,60,255" layout="Stack" direction="Horizontal" padding="8,0,0,0" spacing="6" crossAlign="Center">
              <components>
                <component type="UIInputClicker" action="SetMode" value="list"/>
              </components>
              <children>
                <element type="UIElement" name="ModeListIcon" height="50%" aspectRatio="1">
                  <components>
                    <component type="UIImageComponent" sprite="icons.list"/>
                  </components>
                </element>
                <element type="UIElement" name="ModeListCaption" flex="1" height="100%" fontSize="20">
                  <components>
                    <component type="UITextComponent" text="List" align="Center" verticalAlign="Center" wrap="false"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIElement" flex="1" height="100%" color="70,70,100,255" selectedColor="40,110,60,255" disabledColor="60,60,60,255" layout="Stack" direction="Horizontal" padding="8,0,0,0" spacing="6" crossAlign="Center">
              <components>
                <component type="UIInputClicker" action="SetMode" value="gear" disabled="true"/>
              </components>
              <children>
                <element type="UIElement" width="24" height="24">
                  <components>
                    <component type="UIImageComponent" sprite="icons.gear" tint="255,200,0,255"/>
                  </components>
                </element>
                <element type="UIElement" flex="1" height="100%">
                  <components>
                    <component type="UITextComponent" text="Gear" align="Center" verticalAlign="Center" wrap="false"/>
                  </components>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
