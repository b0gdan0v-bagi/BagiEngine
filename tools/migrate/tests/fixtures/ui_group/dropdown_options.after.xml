<?xml version="1.0"?>
<!-- A UIDropdown as MahjongSetup has it (SeatLevel0): the options are UIButtons with a caption and a value and no `action` (the dropdown emits it), the height of an option is `optionHeight`. -->
<node name="Levels" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIDropdown" name="SeatLevel0" bind="seatLevel0" action="MahjongSetSeatLevel0" x="10" y="10" width="72" height="56" optionHeight="56" text="" fontSize="22" overflow="AutoFit" minFontSize="8" verticalAlign="Center" color="70,70,100,255">
          <children>
            <element type="UIElement" name="Seat0Level1" fontSize="22" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="1" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                <component type="UIInputClicker" value="1"/>
              </components>
            </element>
            <element type="UIElement" name="Seat0Level2" fontSize="22" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="2" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                <component type="UIInputClicker" value="2"/>
              </components>
            </element>
            <element type="UIElement" name="Seat0Level3" fontSize="22" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="3" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                <component type="UIInputClicker" value="3"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIDropdown" name="Speed" bind="speed" action="SetSpeed" x="100" y="10" width="160" height="48" text="Speed" color="50,56,80,255">
          <children>
            <element type="UIElement" name="SlowOption" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="Slow" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" value="slow"/>
                <component type="UITooltipComponent" text="{#tip.slow}"/>
              </components>
            </element>
            <element type="UIElement" name="FastOption" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="Fast" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" value="fast"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
