<?xml version="1.0"?>
<!-- The rows of the options screen of the Mahjong game (config/nodes/MahjongOptions.xml): a UISegmented of plain UIButton segments with a caption, an action, a value and the colour of the chosen one. -->
<node name="Options" layer="30">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.6" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="640" height="100%" maxHeight="600" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIStack" name="LanguageRow" flex="1" maxHeight="64" direction="Horizontal" spacing="8" padding="4,0,4,0" crossAlign="Center" color="48,54,72,255">
              <children>
                <element type="UILabel" name="LanguageCaption" width="112" height="87.5%" text="{#setup.language}" fontSize="22" overflow="AutoFit" minFontSize="12" verticalAlign="Center" textColor="190,196,190,255" />
                <element type="UISegmented" name="Language" bind="language" flex="1" height="87.5%" direction="Horizontal" spacing="4" color="48,54,72,255">
                  <children>
                    <element type="UIElement" name="LanguageEn" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#lang.en}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetLanguage" value="en"/>
                      </components>
                    </element>
                    <element type="UIElement" name="LanguageRu" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#lang.ru}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetLanguage" value="ru"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIStack" name="SpeedRow" flex="1" maxHeight="64" direction="Horizontal" spacing="8" padding="4,0,4,0" crossAlign="Center" color="48,54,72,255">
              <children>
                <element type="UILabel" name="SpeedCaption" width="96" height="87.5%" text="{#options.speed}" fontSize="22" overflow="AutoFit" minFontSize="12" verticalAlign="Center" textColor="190,196,190,255" />
                <element type="UISegmented" name="SpeedChoice" bind="speedChoice" flex="1" height="87.5%" direction="Horizontal" spacing="4" color="48,54,72,255">
                  <children>
                    <element type="UIElement" name="SpeedSlow" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.speedSlow}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetSpeed" value="slow"/>
                      </components>
                    </element>
                    <element type="UIElement" name="SpeedNormal" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.speedNormal}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetSpeed" value="normal"/>
                      </components>
                    </element>
                    <element type="UIElement" name="SpeedFast" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.speedFast}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetSpeed" value="fast"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
      <variants>
        <variant when="maxWidth:480">
          <overrides>
            <set element="LanguageEn" fontSize="18" />
            <set element="Language" spacing="2" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
