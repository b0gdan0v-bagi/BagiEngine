<?xml version="1.0"?>
<!-- A UIDropdown as MahjongSetup has it (SeatLevel0): the options are UIButtons with a caption and a value and no `action` (the dropdown emits it), the height of an option is `optionHeight`. -->
<node name="Levels" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIDropdown" name="SeatLevel0" bind="seatLevel0" action="MahjongSetSeatLevel0" x="10" y="10" width="72" height="56" optionHeight="56" text="" fontSize="22" overflow="AutoFit" minFontSize="8" verticalAlign="Center" color="70,70,100,255">
          <children>
            <element type="UIButton" name="Seat0Level1" text="1" fontSize="22" overflow="AutoFit" minFontSize="12" value="1" color="70,70,100,255" />
            <element type="UIButton" name="Seat0Level2" text="2" fontSize="22" overflow="AutoFit" minFontSize="12" value="2" color="70,70,100,255" />
            <element type="UIButton" name="Seat0Level3" text="3" fontSize="22" overflow="AutoFit" minFontSize="12" value="3" color="70,70,100,255" />
          </children>
        </element>
        <element type="UIDropdown" name="Speed" bind="speed" action="SetSpeed" x="100" y="10" width="160" height="48" text="Speed" color="50,56,80,255">
          <children>
            <element type="UIButton" name="SlowOption" text="Slow" value="slow" tooltip="{#tip.slow}" color="70,70,100,255" />
            <element type="UIButton" name="FastOption" text="Fast" value="fast" color="70,70,100,255" />
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
