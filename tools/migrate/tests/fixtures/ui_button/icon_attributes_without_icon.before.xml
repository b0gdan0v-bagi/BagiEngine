      <elements>
        <element type="UIButton" name="Empty" x="10" y="10" width="120" height="56" text="Go" icon="" iconTint="255,200,0,255" iconSize="32" iconPlacement="Above" action="Go" />
        <element type="UIButton" name="Stray" x="140" y="10" width="120" height="56" text="Stop" iconPlacement="Left" action="Stop" />
      </elements>
    </component>
  </components>
</node>
