<?xml version="1.0"?>
<!-- Nothing to do: an element already composed, and the buttons of a segmented group (left for the step that composes the group; a variant may set what it likes on them). -->
<node name="Composed" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIElement" name="Done" x="10" y="10" width="120" height="56" color="40,90,60,255">
