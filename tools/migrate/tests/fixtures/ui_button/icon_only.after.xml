<?xml version="1.0"?>
<!-- Buttons with an icon and no caption: the icon is the first child, centred, the largest square of 60 % of the shorter side (or iconSize, kept inside the rect). -->
<node name="Icons" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIElement" name="Settings" x="10" y="10" width="56" height="56" color="40,60,90,255">
          <components>
            <component type="UIInputClicker" action="Settings"/>
            <component type="UITooltipComponent" text="{#tip.settings}"/>
          </components>
          <children>
            <element type="UIElement" name="Settings/Icon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.settings"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Sized" x="80" y="10" width="96" height="48">
          <components>
            <component type="UIInputClicker" action="Play"/>
          </components>
          <children>
            <element type="UIElement" name="Sized/Icon" anchor="Center" width="32" height="32" maxWidth="100%" maxHeight="100%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.play"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Tinted" x="190" y="10" width="56" height="56">
          <components>
            <component type="UITextComponent" textColor="255,255,255,255" align="Center" verticalAlign="Center" wrap="false"/>
            <component type="UIInputClicker" action="Pause"/>
          </components>
          <children>
            <element type="UIElement" name="Tinted/Icon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.pause" tint="255,200,0,255"/>
              </components>
            </element>
            <element type="UILabel" name="Dot" width="8" height="8" />
          </children>
        </element>
        <element type="UIElement" name="Hexed" x="260" y="10" width="56" height="56">
          <components>
            <component type="UIInputClicker" action="Stop"/>
          </components>
          <children>
            <element type="UIElement" name="Hexed/Icon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.stop" tint="#FF8800"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Clear" x="330" y="10" width="56" height="56">
          <components>
            <component type="UITextComponent" textColor="10,200,10,255" align="Center" verticalAlign="Center" wrap="false"/>
            <component type="UIInputClicker" action="Stop"/>
          </components>
          <children>
            <element type="UIElement" name="Clear/Icon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.stop" tint="10,200,10,255"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
