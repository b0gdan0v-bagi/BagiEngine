<?xml version="1.0"?>
<!-- A button with an icon and no caption: one image child that is the square that fits (0.6 of the shorter side), or `iconSize` clamped to the button. The tint is the iconTint, else
     the textColor as written (a literal or a token), else white. A button without a name has children without one. -->
<node name="IconOnly" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIElement" name="Settings" x="10" y="10" width="56" height="56" color="40,60,90,255">
          <components>
            <component type="UIInputClicker" action="Settings"/>
            <component type="UITooltipComponent" text="{#tip.settings}"/>
          </components>
          <children>
            <element type="UIElement" name="SettingsIcon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.settings"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Sized" x="70" y="10" width="96" height="48">
          <components>
            <component type="UIInputClicker" action="Play"/>
          </components>
          <children>
            <element type="UIElement" name="SizedIcon" anchor="Center" width="32" height="32" maxWidth="100%" maxHeight="100%">
              <components>
                <component type="UIImageComponent" sprite="icons.play" tint="255,200,0,255"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Tinted" x="176" y="10" width="56" height="56">
          <components>
            <component type="UITextComponent" textColor="240,220,100,255"/>
            <component type="UIInputClicker" action="Gear" value="1"/>
          </components>
          <children>
            <element type="UIElement" name="TintedIcon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.gear" tint="240,220,100,255"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Tokened" x="10" y="80" width="56" height="56">
          <components>
            <component type="UITextComponent" textColor="@accent"/>
            <component type="UIInputClicker" action="Gear" value="2"/>
          </components>
          <children>
            <element type="UIElement" name="TokenedIcon" anchor="Center" width="64" height="64" maxWidth="100%" maxHeight="100%">
              <components>
                <component type="UIImageComponent" sprite="icons.gear" tint="@accent"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Off" x="80" y="80" width="56" height="56" color="40,60,90,255" disabledColor="60,60,60,255">
          <components>
            <component type="UIInputClicker" action="Stop" disabled="true"/>
          </components>
          <children>
            <element type="UIElement" name="OffIcon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.stop"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" x="150" y="80" width="56" height="56">
          <components>
            <component type="UIInputClicker" action="Anonymous"/>
          </components>
          <children>
            <element type="UIElement" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="icons.settings"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
