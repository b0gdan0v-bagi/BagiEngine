<?xml version="1.0"?>
<!-- A menu and a HUD in the shape of a game's SceneConfig.xml, the canvases as they are shipped without the components of the game (the test engine does not have them). -->
<SceneManager>
  <scenes>
    <scene
      type="Scene"
      name="MainMenu">
      <nodes>
        <node name="Menu" layer="10">
          <components>
            <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.7" useSafeArea="true">
              <elements>
                <element type="UIStack" name="Column" anchor="Center" width="90%" maxWidth="320" height="232" direction="Vertical" spacing="16" crossAlign="Stretch">
                  <children>
                    <element type="UILabel" name="Title" height="88" text="Match 3" fontSize="56" align="Center" verticalAlign="Center" />
                    <element type="UIButton" name="Play" height="56" text="Play" fontSize="28" action="GamePlay" color="40,90,60,255" />
                    <element type="UIButton" name="Quit" height="56" text="Quit" fontSize="28" action="GameQuit" color="90,50,50,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
      </nodes>
    </scene>

    <scene
      type="Scene"
      name="GameScene"
      viewWidth="712"
      viewHeight="672">
      <nodes>
        <!-- The HUD is in the margins of the view (space="SceneView"), so it scales and moves with the board and never covers it, whatever the shape of the window. -->
        <node name="Hud" layer="10">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
              <elements>
                <element type="UILabel" name="Score" x="96" y="12" width="250" height="40" text="Score: {score}" fontSize="28" verticalAlign="Center" />
                <element type="UIStack" name="Buttons" anchor="TopRight" x="-96" y="12" width="260" height="48" direction="Horizontal" spacing="12" crossAlign="Stretch">
                  <children>
                    <element type="UIButton" name="Reset" width="124" height="48" text="Reset" fontSize="24" action="GameReset" color="40,90,60,255" />
                    <element type="UIButton" name="Menu" width="124" height="48" text="Menu" fontSize="24" action="GameMenu" color="70,70,100,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
      </nodes>
    </scene>
  </scenes>
</SceneManager>
