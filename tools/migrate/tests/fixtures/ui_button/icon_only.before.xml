<?xml version="1.0"?>
<!-- Buttons with an icon and no caption: the icon is the first child, centred, the largest square of 60 % of the shorter side (or iconSize, kept inside the rect). -->
<node name="Icons" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIButton" name="Settings" x="10" y="10" width="56" height="56" icon="icons.settings" tooltip="{#tip.settings}" action="Settings" color="40,60,90,255" />
        <element type="UIButton" name="Sized" x="80" y="10" width="96" height="48" icon="icons.play" iconSize="32" iconPlacement="Above" action="Play" />
        <element type="UIButton" name="Tinted" x="190" y="10" width="56" height="56" icon="icons.pause" iconTint="255,200,0,255" textColor="255,255,255,255" action="Pause">
          <children>
            <element type="UILabel" name="Dot" width="8" height="8" />
          </children>
        </element>
        <element type="UIButton" name="Hexed" x="260" y="10" width="56" height="56" icon="icons.stop" iconTint="#FF8800" action="Stop" />
        <element type="UIButton" name="Clear" x="330" y="10" width="56" height="56" icon="icons.stop" iconTint="0,0,0,0" textColor="10,200,10,255" action="Stop" />
      </elements>
    </component>
  </components>
</node>
