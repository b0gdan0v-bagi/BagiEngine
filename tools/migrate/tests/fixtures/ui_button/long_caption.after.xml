<?xml version="1.0"?>
<!-- A caption that is wider than the button: a UIButton does not wrap it (it ends with an ellipsis, or shrinks), where a text component wraps unless told not to. -->
<node name="LongCaption" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIElement" name="Ellipsis" x="10" y="10" width="80" height="56" fontSize="22">
          <components>
            <component type="UITextComponent" text="A caption far too long for its rect" align="Center" verticalAlign="Center" wrap="false"/>
            <component type="UIInputClicker" action="Go"/>
          </components>
        </element>
        <element type="UIElement" name="Shrunk" x="110" y="10" width="80" height="56" fontSize="22">
          <components>
            <component type="UITextComponent" text="A caption far too long for its rect" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
            <component type="UIInputClicker" action="Go"/>
          </components>
        </element>
        <element type="UIElement" name="Wrapped" x="210" y="10" width="80" height="80" fontSize="22">
          <components>
            <component type="UITextComponent" text="A caption far too long for its rect" align="Left" verticalAlign="Top" wrap="true"/>
            <component type="UIInputClicker" action="Go"/>
          </components>
        </element>
      </elements>
    </component>
  </components>
</node>
