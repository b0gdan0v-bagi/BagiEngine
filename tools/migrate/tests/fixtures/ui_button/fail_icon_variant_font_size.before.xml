<?xml version="1.0"?>
<!-- Failure: a variant sets the fontSize of a button with an icon and a caption; the caption is another element after the move, so the override would name an attribute the button no
     longer has. A set of the layout (x, width) on the button would have been fine. -->
<node name="IconFontSize" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIButton" name="Play" x="10" y="10" width="200" height="56" icon="icons.play" text="Play" fontSize="22" action="Play" />
      </elements>
      <variants>
        <variant when="orientation:portrait">
          <overrides>
            <set element="Play" x="0" width="90%" fontSize="30" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
