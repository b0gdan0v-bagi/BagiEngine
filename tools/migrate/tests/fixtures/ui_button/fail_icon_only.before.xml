<?xml version="1.0"?>
<!-- Failure: a button with an icon and no caption. Its icon follows the hover, press and disabled state of the button, which an image in a child element would not (only the
     element with the clicker is hovered or pressed); an image component on the element itself, written by hand, does. Both buttons are reported. -->
<node name="IconOnly" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIButton" name="Settings" x="10" y="10" width="56" height="56" icon="icons.settings" tooltip="{#tip.settings}" action="Settings" color="40,60,90,255" />
        <element type="UIButton" name="Sized" x="80" y="10" width="96" height="48" icon="icons.play" iconSize="32" iconPlacement="Above" iconTint="255,200,0,255" action="Play" />
      </elements>
    </component>
  </components>
</node>
