<?xml version="1.0"?>
<!-- A button that only blocks the input behind it: no text and no action. It stays a hit target (the clicker is what makes it one). -->
<node name="Blocker" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen" useSafeArea="false">
      <elements>
        <element type="UIElement" name="Shield" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,120" blocksInput="true">
          <components>
            <component type="UIInputClicker"/>
          </components>
        </element>
        <element type="UIElement" name="Corner" anchor="TopLeft" x="8" y="8" width="56" height="56" color="30,30,30,255" selectedColor="60,60,60,255">
          <components>
            <component type="UIInputClicker"/>
          </components>
        </element>
      </elements>
    </component>
  </components>
</node>
