<?xml version="1.0"?>
<!--
  Lines of the setup panel of the Mahjong game (config/nodes/MahjongSetup.xml, copied as they are). The close cross SetupClose is a plain button and is composed;
  the segments of SeatKind0 (a UISegmented) and the options of SeatLevel0 (a UIDropdown) are found by their group through the class UIButton, so the step leaves them.
-->
<node name="Setup" layer="30">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.6" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="640" height="100%" maxHeight="600" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIStack" name="TitleRow" flex="0.875" maxHeight="56" direction="Horizontal" spacing="0" crossAlign="Stretch" color="58,66,92,255">
              <children>
                <element type="UIButton" name="SetupClose" width="56" text="{#setup.closeMark}" tooltip="{#setup.close}" fontSize="28" overflow="AutoFit" minFontSize="12" action="MahjongSetupClose" color="70,70,100,255" />
              </children>
            </element>
            <element type="UIStack" name="SeatRow0" flex="1" maxHeight="64" direction="Horizontal" spacing="8" padding="4,0,4,0" crossAlign="Center" color="48,54,72,255">
              <children>
                <element type="UISegmented" name="SeatKind0" bind="seatKind0" flex="1" height="87.5%" direction="Horizontal" spacing="4" color="48,54,72,255">
                  <children>
                    <element type="UIButton" name="Seat0Person" flex="1" height="100%" text="{#setup.person}" fontSize="22" overflow="AutoFit" minFontSize="12" action="MahjongSetSeat0" value="person" color="70,70,100,255" selectedColor="40,110,60,255" />
                    <element type="UIButton" name="Seat0Computer" flex="1" height="100%" text="{#setup.computer}" fontSize="22" overflow="AutoFit" minFontSize="12" action="MahjongSetSeat0" value="computer" color="70,70,100,255" selectedColor="40,110,60,255" />
                  </children>
                </element>
                <element type="UIDropdown" name="SeatLevel0" bind="seatLevel0" action="MahjongSetSeatLevel0" width="72" height="87.5%" optionHeight="56" text="" fontSize="22" overflow="AutoFit" minFontSize="8" verticalAlign="Center" color="70,70,100,255">
                  <children>
                    <element type="UIButton" name="Seat0Level1" text="1" fontSize="22" overflow="AutoFit" minFontSize="12" value="1" color="70,70,100,255" />
                    <element type="UIButton" name="Seat0Level2" text="2" fontSize="22" overflow="AutoFit" minFontSize="12" value="2" color="70,70,100,255" />
                  </children>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
      <variants>
        <variant when="maxWidth:480">
          <overrides>
            <set element="SetupClose" width="40" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
