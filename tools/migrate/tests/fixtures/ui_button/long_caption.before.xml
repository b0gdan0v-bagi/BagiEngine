<?xml version="1.0"?>
<!-- A caption that is wider than the button: a UIButton does not wrap it (it ends with an ellipsis, or shrinks), where a text component wraps unless told not to. -->
<node name="LongCaption" layer="5">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIButton" name="Ellipsis" x="10" y="10" width="80" height="56" text="A caption far too long for its rect" fontSize="22" action="Go" />
        <element type="UIButton" name="Shrunk" x="110" y="10" width="80" height="56" text="A caption far too long for its rect" fontSize="22" overflow="AutoFit" minFontSize="12" action="Go" />
        <element type="UIButton" name="Wrapped" x="210" y="10" width="80" height="80" text="A caption far too long for its rect" fontSize="22" wrap="true" align="Left" verticalAlign="Top" action="Go" />
      </elements>
    </component>
  </components>
</node>
