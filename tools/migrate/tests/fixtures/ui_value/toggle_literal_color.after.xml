            <component type="UIInputClicker"/>
            <component type="UIToggleComponent" bind="a" action="A"/>
          </components>
          <children>
            <element type="UIElement" name="DarkCaption" flex="1" height="100%">
              <components>
                <component type="UITextComponent" text="Dark" textColor="190,196,190,255" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
              </components>
            </element>
            <element type="UIElement" name="DarkSwitch" height="100%" aspectRatio="1.25">
              <components>
