<?xml version="1.0"?>
<!-- A textColor that is a theme token: the thumb follows it (the token is copied), the off track cannot be derived from a token, so the author gives trackColor. -->
<node name="Toggles" layer="5" contentVersion="3">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIToggle" name="Themed" bind="a" action="A" x="10" y="10" width="300" height="56" text="Themed" textColor="@text" trackColor="@muted" />
        <element type="UIToggle" name="ThemedThumb" bind="b" action="B" x="10" y="80" width="300" height="56" text="Themed" textColor="@text" trackColor="@muted" thumbColor="@accent" />
      </elements>
    </component>
  </components>
</node>
