      <elements>
        <element type="UISlider" name="Volume" bind="volume" action="SetVolume" minValue="0" maxValue="10" step="0.5" partShape="Round" trackColor="30,30,30,255" fillColor="20,200,90,255" thumbColor="250,250,250,255" x="10" y="10" width="300" height="56" color="70,70,100,255" />
        <element type="UISlider" name="Plain" bind="p" action="P" x="10" y="80" width="300" height="56" />
        <element type="UISlider" x="10" y="150" width="300" height="56" bind="q" action="Q" />
      </elements>
    </component>
  </components>
</node>
