<?xml version="1.0"?>
<!-- A toggle whose textColor is a theme token and that gives no trackColor: the alpha of a token cannot be written. -->
<node name="Toggles" layer="5" contentVersion="3">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIToggle" name="Themed" bind="a" action="A" width="300" height="56" text="Themed" textColor="@text" />
      </elements>
    </component>
  </components>
</node>
