<?xml version="1.0"?>
<!-- A slider with every attribute, then a plain one. -->
<node name="Sliders" layer="5" contentVersion="3">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIElement" name="Volume" x="10" y="10" width="300" height="56" color="70,70,100,255">
          <components>
            <component type="UIInputClicker" stateLook="false"/>
            <component type="UISliderComponent" bind="volume" action="SetVolume" minValue="0" maxValue="10" step="0.5" trackColor="30,30,30,255" fillColor="20,200,90,255" thumbColor="250,250,250,255" partShape="Round"/>
          </components>
        </element>
        <element type="UIElement" name="Plain" x="10" y="80" width="300" height="56">
          <components>
            <component type="UIInputClicker" stateLook="false"/>
            <component type="UISliderComponent" bind="p" action="P"/>
          </components>
        </element>
        <element type="UIElement" x="10" y="150" width="300" height="56">
          <components>
            <component type="UIInputClicker" stateLook="false"/>
            <component type="UISliderComponent" bind="q" action="Q"/>
          </components>
        </element>
      </elements>
    </component>
  </components>
</node>
