<?xml version="1.0"?>
<!-- Nothing to do: a text element, a picture and a dropdown that are composed already. The step is idempotent, and a dropdown keeps its type. -->
<node name="Texts" layer="5" contentVersion="4">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIElement" name="Score" width="200" height="30" fontSize="28">
          <components>
            <component type="UITextComponent" text="Score: {score}"/>
          </components>
        </element>
        <element type="UIElement" name="Star" width="24" height="24">
          <components>
            <component type="UIImageComponent" sprite="icons.star"/>
          </components>
        </element>
        <element type="UIDropdown" name="Level" bind="level" action="SetLevel" width="240" height="56">
          <components>
            <component type="UITextComponent" text="Pick one" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
          </components>
        </element>
      </elements>
    </component>
  </components>
</node>
