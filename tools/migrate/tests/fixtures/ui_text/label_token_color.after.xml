<?xml version="1.0"?>
<!-- A theme token is a colour as written: it moves as it stands. The empty text and a text with quotes are written as the file has them. -->
<node name="Texts" layer="5" contentVersion="4">
  <components>
    <component type="UICanvasComponent" space="Screen">
      <elements>
        <element type="UIElement" name="Themed" width="200" height="30">
          <components>
            <component type="UITextComponent" text="{#hud.score}: {score}" textColor="@text"/>
          </components>
        </element>
        <element type="UIElement" name="Blank" width="200" height="30">
          <components>
            <component type="UITextComponent" text="" textColor="@accent"/>
          </components>
        </element>
        <element type="UIElement" name="Quoted" width="200" height="30">
          <components>
            <component type="UITextComponent" text="Say &quot;hi&quot;"/>
          </components>
        </element>
      </elements>
    </component>
  </components>
</node>
