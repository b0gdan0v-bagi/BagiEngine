{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja"
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF"
            }
        },
        {
            "name": "rmlui",
            "hidden": true,
            "description": "Also builds the vendored RmlUi and its host module RmlUiHost",
            "cacheVariables": {
                "ENGINE_UI_RMLUI": "ON"
            }
        },
        {
            "name": "editor",
            "hidden": true,
            "description": "Builds the editor panels (BE_WITH_EDITOR=ON), also in a Release build",
            "cacheVariables": {
                "BE_WITH_EDITOR": "ON"
            }
        },
        {
            "name": "profile",
            "hidden": true,
            "description": "An optimized build with debug information for measuring (RelWithDebInfo): asserts and expects off, no editor, the profiler and its allocation tracking on",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF",
                "BE_WITH_EDITOR": "OFF",
                "ENGINE_PROFILER": "ON",
                "ENGINE_PROFILER_ALLOC": "ON"
            }
        },
        {
            "name": "tracy",
            "hidden": true,
            "description": "Adds the vendored Tracy client and its profiler backend (src/Modules/tracy/), the default backend then",
            "cacheVariables": {
                "ENGINE_PROFILER_TRACY": "ON"
            }
        },
        {
            "name": "stats",
            "hidden": true,
            "description": "The stats build (ENGINE_PROFILER_STATS=ON): the profiler on in a Release build, also on the web (cmake/BagiPlatformOptions.cmake)",
            "cacheVariables": {
                "ENGINE_PROFILER_STATS": "ON"
            }
        },
        {
            "name": "stats-alloc",
            "hidden": true,
            "inherits": "stats",
            "description": "The stats build with allocation counting; the desktop presets only: the web forces ENGINE_PROFILER_ALLOC off until AllocPlatform is checked under wasm",
            "cacheVariables": {
                "ENGINE_PROFILER_ALLOC": "ON"
            }
        },
        {
            "name": "time-trace",
            "hidden": true,
            "description": "clang -ftime-trace on every compile (ENGINE_TIME_TRACE, cmake/BagiTimeTrace.cmake; read with CI/scripts/time_trace_report.py); ccache off, because a hit writes no trace",
            "cacheVariables": {
                "ENGINE_TIME_TRACE": "ON",
                "ENGINE_CCACHE": "OFF"
            }
        },
        {
            "name": "fuzz",
            "hidden": true,
            "description": "Fuzzing (tests/Fuzz/CLAUDE.md): ASan + UBSan on all code and libFuzzer executables, asserts and expects ON in macos-fuzz (an assertion that input reaches is a finding; macos-fuzz-shipped turns them OFF, as in a shipped build). Homebrew LLVM, because Apple clang has no libFuzzer runtime; it has no default SDK (CMAKE_OSX_SYSROOT), links the system libc++ only with the -L / rpath below and does not search /usr/local/lib, where the Vulkan SDK puts libvulkan.dylib. Intel Homebrew is /usr/local/opt/llvm: change the paths in a CMakeUserPresets.json",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_OSX_SYSROOT": "macosx",
                "CMAKE_EXE_LINKER_FLAGS": "-L/opt/homebrew/opt/llvm/lib/c++ -Wl,-rpath,/opt/homebrew/opt/llvm/lib/c++ -L/usr/local/lib",
                "ENGINE_ENABLE_ASSERTS": "ON",
                "ENGINE_ENABLE_EXPECTS": "ON",
                "ENGINE_FUZZ": "ON",
                "ENGINE_FUZZ_LIBFUZZER": "ON",
                "BE_WITH_EDITOR": "OFF"
            }
        },
        {
            "name": "asan",
            "hidden": true,
            "description": "AddressSanitizer + UndefinedBehaviorSanitizer on all code (ENGINE_SANITIZE, cmake/BagiFuzz.cmake) on the ordinary toolchain of the preset, with no libFuzzer; asserts and expects stay ON (an assertion is a finding too). The test preset macos-asan sets ASAN_OPTIONS and UBSAN_OPTIONS (a stack for every report)",
            "cacheVariables": {
                "ENGINE_SANITIZE": "address;undefined"
            }
        },
        {
            "name": "tsan",
            "hidden": true,
            "description": "ThreadSanitizer on all code (ENGINE_SANITIZE, cmake/BagiFuzz.cmake), optimized with debug information (RelWithDebInfo) so that the tests end in time; asserts and expects stay ON (an assertion is a finding too). The test preset macos-tsan sets TSAN_OPTIONS (the runtime suppressions of cmake/sanitizers/tsan.supp)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENGINE_ENABLE_ASSERTS": "ON",
                "ENGINE_ENABLE_EXPECTS": "ON",
                "ENGINE_SANITIZE": "thread"
            }
        },
        {
            "name": "coverage",
            "hidden": true,
            "description": "Clang source-based coverage on all code (ENGINE_COVERAGE, cmake/BagiFuzz.cmake; report: CI/scripts/coverage_report.py), Debug. ccache off: an object cached from another checkout would map the coverage to that checkout's sources",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENGINE_COVERAGE": "ON",
                "ENGINE_CCACHE": "OFF"
            }
        },
        {
            "name": "asan-windows-crt",
            "hidden": true,
            "description": "No DLL in the build, one static release C runtime (/MT, asserts and expects stay ON, no NDEBUG): the ASan runtime for /MD is a DLL thunk set that defines malloc, so every DLL of the build fails to link with 'duplicate symbol: malloc' against the UCRT import, and the static ASan runtime (asan_cxx is /MT) is refused by an /MD object (/failifmismatch RuntimeLibrary). So SDL, SDL_image and its codecs are static too (the engine's executables then need no SDL DLL); the debug C runtime is not supported by the ASan runtime",
            "cacheVariables": {
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
                "ENGINE_STATIC_SDL": "ON",
                "SDLIMAGE_DEPS_SHARED": "OFF",
                "SDLIMAGE_WEBP_SHARED": "OFF",
                "SDLIMAGE_TIF_SHARED": "OFF"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "vs-env",
            "hidden": true,
            "description": "Ninja on Windows needs the Visual Studio environment; CMake Tools loads it for 'external' strategy",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "no-module-scan",
            "hidden": true,
            "description": "The engine has no C++20 modules; scanning for them needs clang-scan-deps, which not every LLVM on Windows ships",
            "cacheVariables": {
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
            }
        },
        {
            "name": "vs2022",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "web",
            "hidden": true,
            "description": "The browser build with the Emscripten SDK of the submodule external/emsdk (install it once: python CI/scripts/setup_emsdk.py; no environment variable). No tests (ctest does not run wasm), no editor panels",
            "inherits": "ninja",
            "toolchainFile": "${fileDir}/external/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "ENGINE_BUILD_TESTS": "OFF",
                "BE_WITH_EDITOR": "OFF",
                "ENGINE_SINGLE_THREAD": "OFF"
            }
        },
        {
            "name": "web-single-thread",
            "hidden": true,
            "description": "The browser build without threads: no -pthread, no Web Workers, no SharedArrayBuffer, so the page needs no COOP / COEP headers. Its own output folder (build/<preset>/bin)",
            "cacheVariables": {
                "ENGINE_SINGLE_THREAD": "ON"
            }
        },
        {
            "name": "host-macos",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "host-windows",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "host-linux",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": ["ninja", "host-macos", "clang", "debug"]
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": ["ninja", "host-macos", "clang", "release"]
        },
        {
            "name": "macos-rmlui-debug",
            "displayName": "macOS Clang Debug with RmlUi",
            "inherits": ["ninja", "host-macos", "clang", "debug", "rmlui"]
        },
        {
            "name": "macos-rmlui-release",
            "displayName": "macOS Clang Release with RmlUi",
            "inherits": ["ninja", "host-macos", "clang", "release", "rmlui"]
        },
        {
            "name": "macos-release-editor",
            "displayName": "macOS Clang Release with the editor",
            "inherits": ["ninja", "host-macos", "clang", "release", "editor"]
        },
        {
            "name": "macos-profile",
            "displayName": "macOS Clang Profile (RelWithDebInfo, profiler and allocations)",
            "inherits": ["ninja", "host-macos", "clang", "profile"]
        },
        {
            "name": "macos-profile-tracy",
            "displayName": "macOS Clang Profile with Tracy",
            "inherits": ["ninja", "host-macos", "clang", "profile", "tracy"]
        },
        {
            "name": "macos-profile-editor",
            "displayName": "macOS Clang Profile with the editor (the ImGui Profiler panel)",
            "inherits": ["ninja", "host-macos", "clang", "editor", "profile"]
        },
        {
            "name": "macos-release-stats",
            "displayName": "macOS Clang Release stats (the light profiler)",
            "description": "Release plus the light profiler: zones into the frame ring, the overlay, the trace export",
            "inherits": ["ninja", "host-macos", "clang", "release", "stats-alloc"]
        },
        {
            "name": "macos-asan",
            "displayName": "macOS Clang Debug with AddressSanitizer + UBSan",
            "inherits": ["ninja", "host-macos", "clang", "debug", "asan"]
        },
        {
            "name": "macos-tsan",
            "displayName": "macOS Clang with ThreadSanitizer",
            "inherits": ["ninja", "host-macos", "clang", "tsan"]
        },
        {
            "name": "macos-coverage",
            "displayName": "macOS Clang Debug with source-based coverage (no ccache)",
            "inherits": ["ninja", "host-macos", "clang", "coverage"]
        },
        {
            "name": "macos-time-trace",
            "displayName": "macOS Clang Debug with -ftime-trace (compile-time measurement, no ccache)",
            "inherits": ["ninja", "host-macos", "clang", "debug", "time-trace"]
        },
        {
            "name": "macos-fuzz",
            "displayName": "macOS Homebrew LLVM fuzzing (ASan + UBSan, libFuzzer executables)",
            "inherits": ["ninja", "host-macos", "fuzz"]
        },
        {
            "name": "macos-fuzz-shipped",
            "displayName": "macOS Homebrew LLVM fuzzing with the flags of a shipped build (Release, asserts and expects OFF)",
            "inherits": ["ninja", "host-macos", "fuzz"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF"
            }
        },
        {
            "name": "linux-server-release",
            "displayName": "Linux Clang Release for the room server (headless, static SDL, no tests; the Docker image of tools/rooms)",
            "inherits": ["ninja", "host-linux", "clang", "no-module-scan", "release"],
            "cacheVariables": {
                "ENGINE_WITH_VULKAN": "OFF",
                "ENGINE_BUILD_TESTS": "OFF",
                "ENGINE_STATIC_SDL": "ON",
                "BE_WITH_EDITOR": "OFF",
                "SDL_UNIX_CONSOLE_BUILD": "ON",
                "CMAKE_POSITION_INDEPENDENT_CODE": "OFF"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "debug"]
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "release"]
        },
        {
            "name": "windows-msvc-release-editor",
            "displayName": "Windows MSVC Ninja Release with the editor",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "release", "editor"]
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "debug"]
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "release"]
        },
        {
            "name": "windows-clang-asan",
            "displayName": "Windows Clang Ninja Debug with AddressSanitizer + UBSan",
            "description": "Configured and built through CI/scripts/vs_env.py like windows-clang-debug; LLVM must be on PATH. A static build (static CRT and static SDL, mixin asan-windows-crt): no ASan runtime DLL is needed",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "debug", "asan", "asan-windows-crt"]
        },
        {
            "name": "windows-clang-profile-editor",
            "displayName": "Windows Clang Ninja Profile with the editor (the ImGui Profiler panel)",
            "description": "The Windows twin of macos-profile-editor (RelWithDebInfo, the profiler and its allocation tracking, the editor); configured and built through CI/scripts/vs_env.py like windows-clang-debug",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "editor", "profile"]
        },
        {
            "name": "windows-clang-release-stats",
            "displayName": "Windows Clang Ninja Release stats (the light profiler)",
            "description": "Release plus the light profiler: zones into the frame ring, the overlay, the trace export; the Windows twin of macos-release-stats, configured and built through CI/scripts/vs_env.py like windows-clang-debug",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "release", "stats-alloc"]
        },
        {
            "name": "windows-vs2022",
            "displayName": "Windows Visual Studio 2022 (MSVC)",
            "inherits": ["vs2022", "host-windows"]
        },
        {
            "name": "windows-vs2022-clangcl",
            "displayName": "Windows Visual Studio 2022 (ClangCL)",
            "inherits": ["vs2022", "host-windows"],
            "toolset": {
                "value": "ClangCL",
                "strategy": "set"
            }
        },
        {
            "name": "web-debug",
            "displayName": "Web (Emscripten) Debug",
            "inherits": ["web", "debug"]
        },
        {
            "name": "web-release",
            "displayName": "Web (Emscripten) Release",
            "inherits": ["web", "release"]
        },
        {
            "name": "web-debug-single-thread",
            "displayName": "Web (Emscripten) Debug, single thread",
            "inherits": ["web-single-thread", "web", "debug"]
        },
        {
            "name": "web-release-single-thread",
            "displayName": "Web (Emscripten) Release, single thread",
            "inherits": ["web-single-thread", "web", "release"]
        },
        {
            "name": "web-release-stats",
            "displayName": "Web (Emscripten) Release stats (the light profiler)",
            "description": "Release plus the light profiler: zones into the frame ring, the overlay, the trace export",
            "inherits": ["stats", "web", "release"]
        },
        {
            "name": "web-release-single-thread-stats",
            "displayName": "Web (Emscripten) Release stats, single thread",
            "description": "Release plus the light profiler: zones into the frame ring, the overlay, the trace export",
            "inherits": ["web-single-thread", "stats", "web", "release"]
        }
    ],
    "buildPresets": [
        {
            "name": "build-base",
            "hidden": true
        },
        {
            "name": "build-macos",
            "hidden": true,
            "inherits": "build-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "build-linux",
            "hidden": true,
            "inherits": "build-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "build-windows",
            "hidden": true,
            "inherits": "build-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "build-web",
            "hidden": true,
            "inherits": "build-base"
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": "build-macos",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": "build-macos",
            "configurePreset": "macos-release"
        },
        {
            "name": "macos-release-editor",
            "displayName": "macOS Clang Release with the editor",
            "inherits": "build-macos",
            "configurePreset": "macos-release-editor"
        },
        {
            "name": "macos-profile",
            "displayName": "macOS Clang Profile (RelWithDebInfo, profiler and allocations)",
            "inherits": "build-macos",
            "configurePreset": "macos-profile"
        },
        {
            "name": "macos-profile-tracy",
            "displayName": "macOS Clang Profile with Tracy",
            "inherits": "build-macos",
            "configurePreset": "macos-profile-tracy"
        },
        {
            "name": "macos-profile-editor",
            "displayName": "macOS Clang Profile with the editor (the ImGui Profiler panel)",
            "inherits": "build-macos",
            "configurePreset": "macos-profile-editor"
        },
        {
            "name": "macos-release-stats",
            "displayName": "macOS Clang Release stats (the light profiler)",
            "inherits": "build-macos",
            "configurePreset": "macos-release-stats"
        },
        {
            "name": "macos-asan",
            "displayName": "macOS Clang Debug with AddressSanitizer + UBSan",
            "inherits": "build-macos",
            "configurePreset": "macos-asan"
        },
        {
            "name": "macos-tsan",
            "displayName": "macOS Clang with ThreadSanitizer",
            "inherits": "build-macos",
            "configurePreset": "macos-tsan"
        },
        {
            "name": "macos-coverage",
            "displayName": "macOS Clang Debug with source-based coverage",
            "inherits": "build-macos",
            "configurePreset": "macos-coverage"
        },
        {
            "name": "macos-time-trace",
            "displayName": "macOS Clang Debug with -ftime-trace",
            "inherits": "build-macos",
            "configurePreset": "macos-time-trace"
        },
        {
            "name": "macos-fuzz",
            "displayName": "macOS Homebrew LLVM fuzzing (ASan + UBSan, libFuzzer executables)",
            "inherits": "build-macos",
            "configurePreset": "macos-fuzz"
        },
        {
            "name": "macos-fuzz-shipped",
            "displayName": "macOS Homebrew LLVM fuzzing with the flags of a shipped build (Release, asserts and expects OFF)",
            "inherits": "build-macos",
            "configurePreset": "macos-fuzz-shipped"
        },
        {
            "name": "macos-rmlui-debug",
            "displayName": "macOS Clang Debug with RmlUi",
            "inherits": "build-macos",
            "configurePreset": "macos-rmlui-debug"
        },
        {
            "name": "macos-rmlui-release",
            "displayName": "macOS Clang Release with RmlUi",
            "inherits": "build-macos",
            "configurePreset": "macos-rmlui-release"
