{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja"
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF"
            }
        },
        {
            "name": "rmlui",
            "hidden": true,
            "description": "Also builds the vendored RmlUi and its host module RmlUiHost",
            "cacheVariables": {
                "ENGINE_UI_RMLUI": "ON"
            }
        },
        {
            "name": "editor",
            "hidden": true,
            "description": "Builds the editor panels (BE_WITH_EDITOR=ON), also in a Release build",
            "cacheVariables": {
                "BE_WITH_EDITOR": "ON"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "vs-env",
            "hidden": true,
            "description": "Ninja on Windows needs the Visual Studio environment; CMake Tools loads it for 'external' strategy",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "no-module-scan",
            "hidden": true,
            "description": "The engine has no C++20 modules; scanning for them needs clang-scan-deps, which not every LLVM on Windows ships",
            "cacheVariables": {
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
            }
        },
        {
            "name": "vs2022",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "web",
            "hidden": true,
            "description": "The browser build with the Emscripten SDK of the submodule external/emsdk (install it once: python CI/scripts/setup_emsdk.py; no environment variable). No tests (ctest does not run wasm), no editor panels",
            "inherits": "ninja",
            "toolchainFile": "${fileDir}/external/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "ENGINE_BUILD_TESTS": "OFF",
                "BE_WITH_EDITOR": "OFF",
                "ENGINE_SINGLE_THREAD": "OFF"
            }
        },
        {
            "name": "web-single-thread",
            "hidden": true,
            "description": "The browser build without threads: no -pthread, no Web Workers, no SharedArrayBuffer, so the page needs no COOP / COEP headers. Its own output folder (build/<preset>/bin)",
            "cacheVariables": {
                "ENGINE_SINGLE_THREAD": "ON"
            }
        },
        {
            "name": "host-macos",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "host-windows",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": ["ninja", "host-macos", "clang", "debug"]
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": ["ninja", "host-macos", "clang", "release"]
        },
        {
            "name": "macos-rmlui-debug",
            "displayName": "macOS Clang Debug with RmlUi",
            "inherits": ["ninja", "host-macos", "clang", "debug", "rmlui"]
        },
        {
            "name": "macos-rmlui-release",
            "displayName": "macOS Clang Release with RmlUi",
            "inherits": ["ninja", "host-macos", "clang", "release", "rmlui"]
        },
        {
            "name": "macos-release-editor",
            "displayName": "macOS Clang Release with the editor",
            "inherits": ["ninja", "host-macos", "clang", "release", "editor"]
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "debug"]
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "release"]
        },
        {
            "name": "windows-msvc-release-editor",
            "displayName": "Windows MSVC Ninja Release with the editor",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "release", "editor"]
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "debug"]
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "release"]
        },
        {
            "name": "windows-vs2022",
            "displayName": "Windows Visual Studio 2022 (MSVC)",
            "inherits": ["vs2022", "host-windows"]
        },
        {
            "name": "windows-vs2022-clangcl",
            "displayName": "Windows Visual Studio 2022 (ClangCL)",
            "inherits": ["vs2022", "host-windows"],
            "toolset": {
                "value": "ClangCL",
                "strategy": "set"
            }
        },
        {
            "name": "web-debug",
            "displayName": "Web (Emscripten) Debug",
            "inherits": ["web", "debug"]
        },
        {
            "name": "web-release",
            "displayName": "Web (Emscripten) Release",
            "inherits": ["web", "release"]
        },
        {
            "name": "web-debug-single-thread",
            "displayName": "Web (Emscripten) Debug, single thread",
            "inherits": ["web-single-thread", "web", "debug"]
        },
        {
            "name": "web-release-single-thread",
            "displayName": "Web (Emscripten) Release, single thread",
            "inherits": ["web-single-thread", "web", "release"]
        }
    ],
    "buildPresets": [
        {
            "name": "build-base",
            "hidden": true
        },
        {
            "name": "build-macos",
            "hidden": true,
            "inherits": "build-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "build-windows",
            "hidden": true,
            "inherits": "build-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "build-web",
            "hidden": true,
            "inherits": "build-base"
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": "build-macos",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": "build-macos",
            "configurePreset": "macos-release"
        },
        {
            "name": "macos-release-editor",
            "displayName": "macOS Clang Release with the editor",
            "inherits": "build-macos",
            "configurePreset": "macos-release-editor"
        },
        {
            "name": "macos-rmlui-debug",
            "displayName": "macOS Clang Debug with RmlUi",
            "inherits": "build-macos",
            "configurePreset": "macos-rmlui-debug"
        },
        {
            "name": "macos-rmlui-release",
            "displayName": "macOS Clang Release with RmlUi",
            "inherits": "build-macos",
            "configurePreset": "macos-rmlui-release"
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-msvc-debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": "build-windows",
            "configurePreset": "windows-msvc-release"
        },
        {
            "name": "windows-msvc-release-editor",
            "displayName": "Windows MSVC Ninja Release with the editor",
            "inherits": "build-windows",
            "configurePreset": "windows-msvc-release-editor"
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-clang-debug"
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": "build-windows",
            "configurePreset": "windows-clang-release"
        },
        {
            "name": "windows-vs2022-debug",
            "displayName": "Windows Visual Studio 2022 (MSVC) Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2022-release",
            "displayName": "Windows Visual Studio 2022 (MSVC) Release",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2022-clangcl-debug",
            "displayName": "Windows Visual Studio 2022 (ClangCL) Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022-clangcl",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2022-clangcl-release",
            "displayName": "Windows Visual Studio 2022 (ClangCL) Release",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022-clangcl",
            "configuration": "Release"
        },
        {
            "name": "web-debug",
            "displayName": "Web (Emscripten) Debug",
            "inherits": "build-web",
            "configurePreset": "web-debug"
        },
        {
            "name": "web-release",
            "displayName": "Web (Emscripten) Release",
            "inherits": "build-web",
            "configurePreset": "web-release"
        },
        {
            "name": "web-debug-single-thread",
            "displayName": "Web (Emscripten) Debug, single thread",
            "inherits": "build-web",
            "configurePreset": "web-debug-single-thread"
        },
        {
            "name": "web-release-single-thread",
            "displayName": "Web (Emscripten) Release, single thread",
            "inherits": "build-web",
            "configurePreset": "web-release-single-thread"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "jobs": 8
            }
        },
        {
            "name": "test-macos",
            "hidden": true,
            "inherits": "test-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "test-windows",
            "hidden": true,
            "inherits": "test-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": "test-macos",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": "test-macos",
            "configurePreset": "macos-release"
        },
        {
            "name": "macos-release-editor",
            "displayName": "macOS Clang Release with the editor",
            "inherits": "test-macos",
            "configurePreset": "macos-release-editor"
        },
        {
            "name": "macos-rmlui-debug",
            "displayName": "macOS Clang Debug with RmlUi",
            "inherits": "test-macos",
            "configurePreset": "macos-rmlui-debug"
        },
        {
            "name": "macos-rmlui-release",
            "displayName": "macOS Clang Release with RmlUi",
            "inherits": "test-macos",
            "configurePreset": "macos-rmlui-release"
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": "test-windows",
            "configurePreset": "windows-msvc-debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": "test-windows",
            "configurePreset": "windows-msvc-release"
        },
        {
            "name": "windows-msvc-release-editor",
            "displayName": "Windows MSVC Ninja Release with the editor",
            "inherits": "test-windows",
            "configurePreset": "windows-msvc-release-editor"
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": "test-windows",
            "configurePreset": "windows-clang-debug"
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": "test-windows",
            "configurePreset": "windows-clang-release"
        },
        {
            "name": "windows-vs2022-debug",
            "displayName": "Windows Visual Studio 2022 (MSVC) Debug",
            "inherits": "test-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2022-release",
            "displayName": "Windows Visual Studio 2022 (MSVC) Release",
            "inherits": "test-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2022-clangcl-debug",
            "displayName": "Windows Visual Studio 2022 (ClangCL) Debug",
            "inherits": "test-windows",
            "configurePreset": "windows-vs2022-clangcl",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2022-clangcl-release",
            "displayName": "Windows Visual Studio 2022 (ClangCL) Release",
            "inherits": "test-windows",
            "configurePreset": "windows-vs2022-clangcl",
            "configuration": "Release"
        }
    ]
}
