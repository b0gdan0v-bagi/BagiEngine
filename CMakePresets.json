{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja"
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF"
            }
        },
        {
            "name": "rmlui",
            "hidden": true,
            "description": "Also builds the vendored RmlUi and its host module RmlUiHost",
            "cacheVariables": {
                "ENGINE_UI_RMLUI": "ON"
            }
        },
        {
            "name": "editor",
            "hidden": true,
            "description": "Builds the editor panels (BE_WITH_EDITOR=ON), also in a Release build",
            "cacheVariables": {
                "BE_WITH_EDITOR": "ON"
            }
        },
        {
            "name": "profile",
            "hidden": true,
            "description": "An optimized build with debug information for measuring (RelWithDebInfo): asserts and expects off, no editor, the profiler and its allocation tracking on",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF",
                "BE_WITH_EDITOR": "OFF",
                "ENGINE_PROFILER": "ON",
                "ENGINE_PROFILER_ALLOC": "ON"
            }
        },
        {
            "name": "tracy",
            "hidden": true,
            "description": "Adds the vendored Tracy client and its profiler backend (src/Modules/tracy/), the default backend then",
            "cacheVariables": {
                "ENGINE_PROFILER_TRACY": "ON"
            }
        },
        {
            "name": "fuzz",
            "hidden": true,
            "description": "Fuzzing (tests/Fuzz/CLAUDE.md): ASan + UBSan on all code and libFuzzer executables, asserts and expects ON in macos-fuzz (an assertion that input reaches is a finding; macos-fuzz-shipped turns them OFF, as in a shipped build). Homebrew LLVM, because Apple clang has no libFuzzer runtime; it has no default SDK (CMAKE_OSX_SYSROOT), links the system libc++ only with the -L / rpath below and does not search /usr/local/lib, where the Vulkan SDK puts libvulkan.dylib. Intel Homebrew is /usr/local/opt/llvm: change the paths in a CMakeUserPresets.json",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_OSX_SYSROOT": "macosx",
                "CMAKE_EXE_LINKER_FLAGS": "-L/opt/homebrew/opt/llvm/lib/c++ -Wl,-rpath,/opt/homebrew/opt/llvm/lib/c++ -L/usr/local/lib",
                "ENGINE_ENABLE_ASSERTS": "ON",
                "ENGINE_ENABLE_EXPECTS": "ON",
                "ENGINE_FUZZ": "ON",
                "ENGINE_FUZZ_LIBFUZZER": "ON",
                "BE_WITH_EDITOR": "OFF"
            }
        },
        {
            "name": "asan",
            "hidden": true,
            "description": "AddressSanitizer + UndefinedBehaviorSanitizer on all code (ENGINE_SANITIZE, cmake/BagiFuzz.cmake) on the ordinary toolchain of the preset, with no libFuzzer; asserts and expects stay ON (an assertion is a finding too). The test preset macos-asan sets ASAN_OPTIONS and UBSAN_OPTIONS (a stack for every report)",
            "cacheVariables": {
                "ENGINE_SANITIZE": "address;undefined"
            }
        },
        {
            "name": "asan-windows-crt",
            "hidden": true,
            "description": "ASan's Windows runtime is built against the release C runtime, so the Debug build type links /MD (asserts and expects stay ON, no NDEBUG). With a runtime that supports the debug C runtime, MultiThreadedDebugDLL is the one-line change",
            "cacheVariables": {
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "vs-env",
            "hidden": true,
            "description": "Ninja on Windows needs the Visual Studio environment; CMake Tools loads it for 'external' strategy",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "no-module-scan",
            "hidden": true,
            "description": "The engine has no C++20 modules; scanning for them needs clang-scan-deps, which not every LLVM on Windows ships",
            "cacheVariables": {
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
            }
        },
        {
            "name": "vs2022",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "web",
            "hidden": true,
            "description": "The browser build with the Emscripten SDK of the submodule external/emsdk (install it once: python CI/scripts/setup_emsdk.py; no environment variable). No tests (ctest does not run wasm), no editor panels",
            "inherits": "ninja",
            "toolchainFile": "${fileDir}/external/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "ENGINE_BUILD_TESTS": "OFF",
                "BE_WITH_EDITOR": "OFF",
                "ENGINE_SINGLE_THREAD": "OFF"
            }
        },
        {
            "name": "web-single-thread",
            "hidden": true,
            "description": "The browser build without threads: no -pthread, no Web Workers, no SharedArrayBuffer, so the page needs no COOP / COEP headers. Its own output folder (build/<preset>/bin)",
            "cacheVariables": {
                "ENGINE_SINGLE_THREAD": "ON"
            }
        },
        {
            "name": "host-macos",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "host-windows",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "host-linux",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": ["ninja", "host-macos", "clang", "debug"]
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": ["ninja", "host-macos", "clang", "release"]
        },
        {
            "name": "macos-rmlui-debug",
            "displayName": "macOS Clang Debug with RmlUi",
            "inherits": ["ninja", "host-macos", "clang", "debug", "rmlui"]
        },
        {
            "name": "macos-rmlui-release",
            "displayName": "macOS Clang Release with RmlUi",
            "inherits": ["ninja", "host-macos", "clang", "release", "rmlui"]
        },
        {
            "name": "macos-release-editor",
            "displayName": "macOS Clang Release with the editor",
            "inherits": ["ninja", "host-macos", "clang", "release", "editor"]
        },
        {
            "name": "macos-profile",
            "displayName": "macOS Clang Profile (RelWithDebInfo, profiler and allocations)",
            "inherits": ["ninja", "host-macos", "clang", "profile"]
        },
        {
            "name": "macos-profile-tracy",
            "displayName": "macOS Clang Profile with Tracy",
            "inherits": ["ninja", "host-macos", "clang", "profile", "tracy"]
        },
        {
            "name": "macos-profile-editor",
            "displayName": "macOS Clang Profile with the editor (the ImGui Profiler panel)",
            "inherits": ["ninja", "host-macos", "clang", "editor", "profile"]
        },
        {
            "name": "macos-asan",
            "displayName": "macOS Clang Debug with AddressSanitizer + UBSan",
            "inherits": ["ninja", "host-macos", "clang", "debug", "asan"]
        },
        {
            "name": "macos-fuzz",
            "displayName": "macOS Homebrew LLVM fuzzing (ASan + UBSan, libFuzzer executables)",
            "inherits": ["ninja", "host-macos", "fuzz"]
        },
        {
            "name": "macos-fuzz-shipped",
            "displayName": "macOS Homebrew LLVM fuzzing with the flags of a shipped build (Release, asserts and expects OFF)",
            "inherits": ["ninja", "host-macos", "fuzz"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF"
            }
        },
        {
            "name": "linux-server-release",
            "displayName": "Linux Clang Release for the room server (headless, static SDL, no tests; the Docker image of tools/rooms)",
            "inherits": ["ninja", "host-linux", "clang", "no-module-scan", "release"],
            "cacheVariables": {
                "ENGINE_WITH_VULKAN": "OFF",
                "ENGINE_BUILD_TESTS": "OFF",
                "ENGINE_STATIC_SDL": "ON",
                "BE_WITH_EDITOR": "OFF",
                "SDL_UNIX_CONSOLE_BUILD": "ON",
                "CMAKE_POSITION_INDEPENDENT_CODE": "OFF"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "debug"]
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "release"]
        },
        {
            "name": "windows-msvc-release-editor",
            "displayName": "Windows MSVC Ninja Release with the editor",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "release", "editor"]
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "debug"]
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "release"]
        },
        {
            "name": "windows-clang-asan",
            "displayName": "Windows Clang Ninja Debug with AddressSanitizer + UBSan",
            "description": "Configured and built through CI/scripts/vs_env.py like windows-clang-debug; LLVM must be on PATH (its ASan runtime DLL is copied at configure)",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "no-module-scan", "debug", "asan", "asan-windows-crt"]
        },
        {
            "name": "windows-vs2022",
            "displayName": "Windows Visual Studio 2022 (MSVC)",
            "inherits": ["vs2022", "host-windows"]
        },
        {
            "name": "windows-vs2022-clangcl",
            "displayName": "Windows Visual Studio 2022 (ClangCL)",
            "inherits": ["vs2022", "host-windows"],
            "toolset": {
                "value": "ClangCL",
                "strategy": "set"
            }
        },
        {
            "name": "web-debug",
            "displayName": "Web (Emscripten) Debug",
            "inherits": ["web", "debug"]
        },
        {
            "name": "web-release",
            "displayName": "Web (Emscripten) Release",
            "inherits": ["web", "release"]
        },
        {
            "name": "web-debug-single-thread",
            "displayName": "Web (Emscripten) Debug, single thread",
            "inherits": ["web-single-thread", "web", "debug"]
        },
        {
            "name": "web-release-single-thread",
            "displayName": "Web (Emscripten) Release, single thread",
            "inherits": ["web-single-thread", "web", "release"]
        }
    ],
