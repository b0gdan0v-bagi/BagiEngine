{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja"
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENGINE_ENABLE_ASSERTS": "OFF",
                "ENGINE_ENABLE_EXPECTS": "OFF"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "vs-env",
            "hidden": true,
            "description": "Ninja on Windows needs the Visual Studio environment; CMake Tools loads it for 'external' strategy",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "vs2022",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "host-macos",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "host-windows",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": ["ninja", "host-macos", "clang", "debug"]
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": ["ninja", "host-macos", "clang", "release"]
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "debug"]
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "msvc", "release"]
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "debug"]
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": ["ninja", "host-windows", "vs-env", "clang", "release"]
        },
        {
            "name": "windows-vs2022",
            "displayName": "Windows Visual Studio 2022 (MSVC)",
            "inherits": ["vs2022", "host-windows"]
        },
        {
            "name": "windows-vs2022-clangcl",
            "displayName": "Windows Visual Studio 2022 (ClangCL)",
            "inherits": ["vs2022", "host-windows"],
            "toolset": {
                "value": "ClangCL",
                "strategy": "set"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-base",
            "hidden": true,
            "targets": ["MyGame"]
        },
        {
            "name": "build-macos",
            "hidden": true,
            "inherits": "build-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "build-windows",
            "hidden": true,
            "inherits": "build-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": "build-macos",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": "build-macos",
            "configurePreset": "macos-release"
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-msvc-debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": "build-windows",
            "configurePreset": "windows-msvc-release"
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-clang-debug"
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": "build-windows",
            "configurePreset": "windows-clang-release"
        },
        {
            "name": "windows-vs2022-debug",
            "displayName": "Windows Visual Studio 2022 (MSVC) Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2022-release",
            "displayName": "Windows Visual Studio 2022 (MSVC) Release",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2022-clangcl-debug",
            "displayName": "Windows Visual Studio 2022 (ClangCL) Debug",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022-clangcl",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2022-clangcl-release",
            "displayName": "Windows Visual Studio 2022 (ClangCL) Release",
            "inherits": "build-windows",
            "configurePreset": "windows-vs2022-clangcl",
            "configuration": "Release"
        }
    ]
}
