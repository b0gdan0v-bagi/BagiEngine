        },
        { "name": "macos-release-editor-all", "inherits": ["test-all", "macos-release-editor"] },
        { "name": "macos-release-editor-fast", "inherits": ["test-fast", "macos-release-editor"] },
        { "name": "macos-release-editor-smoke", "inherits": ["test-smoke", "macos-release-editor"] },
        { "name": "macos-release-editor-scenarios", "inherits": ["test-scenarios", "macos-release-editor"] },
        {
            "name": "macos-asan",
            "displayName": "macOS Clang Debug with AddressSanitizer + UBSan",
            "inherits": "test-macos",
            "configurePreset": "macos-asan",
            "environment": {
                "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1",
                "UBSAN_OPTIONS": "print_stacktrace=1"
            }
        },
        { "name": "macos-asan-all", "inherits": ["test-all", "macos-asan"] },
        { "name": "macos-asan-fast", "inherits": ["test-fast", "macos-asan"] },
        { "name": "macos-asan-smoke", "inherits": ["test-smoke", "macos-asan"] },
        { "name": "macos-asan-scenarios", "inherits": ["test-scenarios", "macos-asan"] },
