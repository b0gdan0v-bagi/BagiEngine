    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "jobs": 8
            },
            "filter": {
                "exclude": {
                    "label": "^(extended|native-watch)$"
                }
            }
        },
        {
            "name": "test-all",
            "hidden": true,
            "description": "Every test, extended included; native-watch (the real OS file watch, run only for a change of it: ctest --test-dir build/<preset> -L native-watch) is not. An inherited filter field can be replaced but not removed",
            "filter": {
                "exclude": {
                    "label": "^native-watch$"
                }
            }
        },
        {
            "name": "test-fast",
            "hidden": true,
            "description": "The default set without the tests that start a game",
            "filter": {
                "exclude": {
                    "label": "^(smoke|scenario|extended|native-watch)$"
                }
            }
        },
        {
            "name": "test-smoke",
            "hidden": true,
            "description": "The smoke tests only, extended ones included",
            "filter": {
                "include": {
                    "label": "^smoke$"
                },
                "exclude": {
                    "label": "^$"
                }
            }
        },
        {
            "name": "test-scenarios",
            "hidden": true,
            "description": "The scenario files and their QA replays only",
            "filter": {
                "include": {
                    "label": "^scenario$"
                },
                "exclude": {
                    "label": "^$"
                }
            }
        },
        {
            "name": "test-macos",
            "hidden": true,
            "inherits": "test-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "test-windows",
            "hidden": true,
            "inherits": "test-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": "test-macos",
            "configurePreset": "macos-debug"
        },
        { "name": "macos-debug-all", "inherits": ["test-all", "macos-debug"] },
        { "name": "macos-debug-fast", "inherits": ["test-fast", "macos-debug"] },
        { "name": "macos-debug-smoke", "inherits": ["test-smoke", "macos-debug"] },
        { "name": "macos-debug-scenarios", "inherits": ["test-scenarios", "macos-debug"] },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": "test-macos",
            "configurePreset": "macos-release"
        },
        { "name": "macos-release-all", "inherits": ["test-all", "macos-release"] },
        { "name": "macos-release-fast", "inherits": ["test-fast", "macos-release"] },
        { "name": "macos-release-smoke", "inherits": ["test-smoke", "macos-release"] },
