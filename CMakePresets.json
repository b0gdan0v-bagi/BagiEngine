    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "jobs": 8
            }
        },
        {
            "name": "test-macos",
            "hidden": true,
            "inherits": "test-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "test-windows",
            "hidden": true,
            "inherits": "test-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Clang Debug",
            "inherits": "test-macos",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "displayName": "macOS Clang Release",
            "inherits": "test-macos",
            "configurePreset": "macos-release"
        },
        {
            "name": "macos-release-editor",
            "displayName": "macOS Clang Release with the editor",
            "inherits": "test-macos",
            "configurePreset": "macos-release-editor"
        },
        {
            "name": "macos-asan",
            "displayName": "macOS Clang Debug with AddressSanitizer + UBSan",
            "inherits": "test-macos",
            "configurePreset": "macos-asan",
            "environment": {
                "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1",
                "UBSAN_OPTIONS": "print_stacktrace=1"
            }
        },
        {
            "name": "macos-fuzz",
            "displayName": "macOS Homebrew LLVM fuzzing (ASan + UBSan, libFuzzer executables)",
            "inherits": "test-macos",
            "configurePreset": "macos-fuzz"
        },
        {
            "name": "macos-fuzz-shipped",
            "displayName": "macOS Homebrew LLVM fuzzing with the flags of a shipped build (Release, asserts and expects OFF)",
            "inherits": "test-macos",
            "configurePreset": "macos-fuzz-shipped"
        },
        {
            "name": "macos-profile",
            "displayName": "macOS Clang Profile (RelWithDebInfo, profiler and allocations)",
            "inherits": "test-macos",
            "configurePreset": "macos-profile"
        },
        {
            "name": "macos-profile-tracy",
            "displayName": "macOS Clang Profile with Tracy",
            "inherits": "test-macos",
            "configurePreset": "macos-profile-tracy"
        },
        {
            "name": "macos-profile-editor",
            "displayName": "macOS Clang Profile with the editor (the ImGui Profiler panel)",
            "inherits": "test-macos",
            "configurePreset": "macos-profile-editor"
        },
        {
            "name": "macos-rmlui-debug",
            "displayName": "macOS Clang Debug with RmlUi",
            "inherits": "test-macos",
            "configurePreset": "macos-rmlui-debug"
        },
        {
            "name": "macos-rmlui-release",
            "displayName": "macOS Clang Release with RmlUi",
            "inherits": "test-macos",
            "configurePreset": "macos-rmlui-release"
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Ninja Debug",
            "inherits": "test-windows",
            "configurePreset": "windows-msvc-debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Ninja Release",
            "inherits": "test-windows",
            "configurePreset": "windows-msvc-release"
        },
        {
            "name": "windows-msvc-release-editor",
            "displayName": "Windows MSVC Ninja Release with the editor",
            "inherits": "test-windows",
            "configurePreset": "windows-msvc-release-editor"
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Ninja Debug",
            "inherits": "test-windows",
            "configurePreset": "windows-clang-debug"
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Ninja Release",
            "inherits": "test-windows",
            "configurePreset": "windows-clang-release"
        },
        {
            "name": "windows-clang-asan",
            "displayName": "Windows Clang Ninja Debug with AddressSanitizer + UBSan",
            "inherits": "test-windows",
            "configurePreset": "windows-clang-asan",
            "environment": {
                "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1",
                "UBSAN_OPTIONS": "print_stacktrace=1"
            }
        },
        {
            "name": "windows-vs2022-debug",
            "displayName": "Windows Visual Studio 2022 (MSVC) Debug",
            "inherits": "test-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2022-release",
            "displayName": "Windows Visual Studio 2022 (MSVC) Release",
            "inherits": "test-windows",
            "configurePreset": "windows-vs2022",
            "configuration": "Release"
