<PanelAsset id="ConfigEditor" title="Config Editor" command="view.configEditor" open="true" width="900" height="550">
  <sources>
    <source name="editor" model="ConfigEditorPanelModel"/>
  </sources>
  <elements>
    <element type="PanelRow" id="panes">
      <elements>
        <element type="PanelChild" id="list" width="14" border="true">
          <elements>
            <element type="PanelText" id="listTitle" text="Configs"/>
            <element type="PanelText" id="listCount" bind="editor.countText" style="Disabled"/>
            <element type="PanelSeparator" id="listLine"/>
            <element type="PanelTable" id="configs" source="editor.configs" header="false">
              <columns>
                <column type="Selectable" id="name" field="name" selectedField="selected" command="configEditor.select" argument="name"/>
              </columns>
            </element>
          </elements>
        </element>
        <element type="PanelChild" id="detail" border="true">
          <elements>
            <element type="PanelEmptyState" id="noSelection" icon="file-text" text="Select a config on the left to start editing." visible="!editor.hasSelection"/>
            <element type="PanelRow" id="actions" visible="editor.hasSelection">
              <elements>
                <element type="PanelButton" id="save" text="Save" icon="save" command="config.save" enableWhen="editor.hasStaged"/>
                <element type="PanelButton" id="reload" text="Reload" icon="refresh-cw" command="configEditor.reload"/>
              </elements>
            </element>
            <element type="PanelSlot" id="tree" name="configTree" visible="editor.showTree"/>
          </elements>
        </element>
      </elements>
    </element>
    <element type="PanelPopup" id="reloadConfirm" title="Unsaved Changes" open="editor.reloadConfirmOpen">
      <elements>
        <element type="PanelText" id="reloadMessage" bind="editor.reloadMessage"/>
        <element type="PanelRow" id="reloadButtons">
          <elements>
            <element type="PanelButton" id="discard" text="Discard &amp; Reload" icon="undo-2" command="configEditor.reloadDiscard"/>
            <element type="PanelButton" id="cancel" text="Cancel" icon="x" command="configEditor.reloadCancel"/>
          </elements>
        </element>
      </elements>
    </element>
    <element type="PanelPopup" id="switchConfirm" title="Unsaved Changes" open="editor.switchConfirmOpen">
      <elements>
        <element type="PanelText" id="switchMessage" text="Switch config and discard changes?"/>
      </elements>
    </element>
  </elements>
</PanelAsset>
