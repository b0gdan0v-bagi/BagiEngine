# BagiEngine Environment Configuration
# Copy this file to .env and set your local paths
# IMPORTANT: Save this file as UTF-8 WITHOUT BOM

# Optional: the LLVM installation directory, where the clang-format and clang-tidy lookups also search
# (CI/scripts/format_sources.py, the tidy-fix skill); reflection code generation does not need it
# Use forward slashes (/) or double backslashes (\\) in paths
# Example Windows: LIBCLANG_PATH=C:/Program Files/LLVM
# Example macOS: LIBCLANG_PATH=/usr/local/opt/llvm
# Example Linux: LIBCLANG_PATH=/usr/lib/llvm-18
LIBCLANG_PATH=

# The todo store (tools/todo/CLAUDE.md): the address of the service (no /api/v1) and this checkout's own token, limited to
# its areas and issued by the owner. Never commit the token. Both are optional: only the todo entries, plans and reviews
# need them, never the build or the tests.
TODO_API_URL=
TODO_API_TOKEN=

# The upload token of the engine's site (tools/web/DEPLOY.md, "A site page"): the site's owner issues it (the site's
# BUILD_UPLOAD_TOKEN). Leave it empty here, put the value only into your own .env, never commit it. Only
# `build_and_deploy.py --target <a site page> --deploy` reads it, and it prints it nowhere.
ENGINE_SITE_UPLOAD_TOKEN=
