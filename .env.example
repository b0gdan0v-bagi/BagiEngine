# BagiEngine Environment Configuration
# Copy this file to .env and set your local paths
# IMPORTANT: Save this file as UTF-8 WITHOUT BOM

# Path to LLVM installation directory (required for reflection code generation)
# Use forward slashes (/) or double backslashes (\\) in paths
# Example Windows: LIBCLANG_PATH=C:/Program Files/LLVM
# Example macOS: LIBCLANG_PATH=/usr/local/opt/llvm
# Example Linux: LIBCLANG_PATH=/usr/lib/llvm-18
LIBCLANG_PATH=

# The todo store (tools/todo/CLAUDE.md): the service on Railway and its token. Never commit the token.
TODO_API_URL=https://todo-api-production-ee7b.up.railway.app
TODO_API_TOKEN=
